    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.86",
    "gliner": "^0.0.19"
  }
}
